# Neon / Vercel Postgres connection strings (use the SAME two values locally and on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Long random string used to sign login cookies
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Public site URL (your vercel.app address after first deploy)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Razorpay — optional for CEO preview (COD still works)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Seeded CRM admin (change after first login)
ADMIN_EMAIL="leo.a@example.org"
ADMIN_PASSWORD="Nuvelist@Admin1"
